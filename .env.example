GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
PORT=3000
NODE_ENV=production
# Frontend API origin; leave blank for the local same-origin Express/Vite app. Do not add /api.
VITE_API_BASE_URL=

# Comma-separated exact browser origins allowed to call the backend.
FRONTEND_ORIGINS=

# Use none with COOKIE_SECURE=true for separate HTTPS Vercel/Render origins.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional directory containing merchant_intelligence_db.json; defaults to ./data.
MERCHANTIQ_DATA_DIR=
